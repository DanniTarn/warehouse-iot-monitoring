# Public hostname that resolves to this server. DuckDNS gives one for free.
# Without a domain, use <public-ip>.sslip.io, which resolves with no setup.
SITE_ADDRESS=warehouse-demo.duckdns.org

# Bind the web ports to one interface when another service already holds 443
# on a different address, such as a Tailscale listener. Leave empty for all.
PUBLIC_BIND_IP=

POSTGRES_PASSWORD=replace_with_a_database_password
MONGO_USERNAME=warehouse_admin
MONGO_PASSWORD=replace_with_a_mongo_password
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_characters

# Credentials the backend uses to publish commands. Create the same user with
# mosquitto_passwd. Devices get their own users.
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=replace_with_a_broker_password

SEED_DEFAULT_NODES=true
SYNC_THRESHOLDS_ON_HEARTBEAT=false

# Night window, wrapping midnight. Inside it alerts are CRITICAL and the
# backend sends BUZZER_ON. Outside it they are WARNING. Start == end means
# every hour counts as night.
NIGHT_TIMEZONE=Asia/Ho_Chi_Minh
NIGHT_START_HOUR=20
NIGHT_END_HOUR=6
OFFLINE_TIMEOUT_SECONDS=30
